# Database Configuration
# In local development without Postgres, falls back gracefully to SQLite: sqlite:///./smart_watchlist.db
DATABASE_URL=sqlite:///./smart_watchlist.db
# For PostgreSQL (e.g. docker or local):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_watchlist

# JWT Authentication
JWT_SECRET=c84910e53a2ef819bc8d5930129a28e83b4b576829a8f4c2810471b6d0812903
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Market Data Provider
# Options: yahoo, upstox, zerodha, alphavantage
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=

# News Provider
# Options: yahoo, newsapi, finnhub
NEWS_PROVIDER=yahoo
NEWS_API_KEY=

# LLM / Intelligence Provider
# Options: builtin, openai, gemini
LLM_PROVIDER=builtin
LLM_API_KEY=

# Application & CORS
FRONTEND_ORIGIN=*
PORT=8000
HOST=0.0.0.0
